# =============================================================================
# Smart Ambulance Emergency Corridor - Configuration
# =============================================================================

# --- Mode ---
DEMO_MODE=true

# --- Camera ---
# Use 0 for webcam, or path to video file for demo
CAMERA_SOURCE=0
FRAME_SKIP=2

# --- YOLO ---
YOLO_MODEL=yolov8n.pt
MIN_DETECTION_CONFIDENCE=0.5

# --- Tracking ---
MAX_DISAPPEARED_FRAMES=30
MAX_TRACK_DISTANCE=80

# --- Emergency Corridor ---
CORRIDOR_TOP_WIDTH_RATIO=0.3
CORRIDOR_BOTTOM_WIDTH_RATIO=0.8
CORRIDOR_TOP_Y_RATIO=0.3
CORRIDOR_BOTTOM_Y_RATIO=0.95

# --- Violation ---
MIN_BLOCKING_TIME=3
MIN_MOVEMENT_THRESHOLD=15

# --- Plate / OCR ---
MIN_PLATE_CONFIDENCE=0.4
OCR_ENGINE=easyocr
# Dedicated YOLOv8 detector supplied with the ANPR module. Set false to use
# the existing contour/morphology detector only.
PLATE_DETECTOR_ENABLED=true
PLATE_MODEL=backend/anpr_demo/models/license_plate_detector.pt
PLATE_DETECTION_CONFIDENCE=0.35

# --- Database ---
DATABASE_URL=sqlite:///./data/tms.db

# --- Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# --- OSRM ---
OSRM_URL=https://router.project-osrm.org

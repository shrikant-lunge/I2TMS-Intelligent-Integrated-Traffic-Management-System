# =========================
# Generated Evidence / Output
# =========================

# Runtime data can contain recordings, generated evidence, and SQLite state.
# Keep it local; scripts recreate the required folders when the app starts.
data/
/models/
backend/.ultralytics/
backend/tmp_*
backend/sample_frame_*.png
backend/anpr_demo/test.csv

# This detector is a required, intentionally bundled ANPR runtime asset.
!backend/anpr_demo/models/
!backend/anpr_demo/models/license_plate_detector.pt

data/evidence/
data/outputs/
outputs/
tmp/
temp/

